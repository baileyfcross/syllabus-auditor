# Configure trusted TLS certificates in your Nginx HTTPS server block.
# Do NOT expose the internal Uvicorn port directly to the public internet.
server {
    listen 443 ssl http2;
    server_name syllabi.baileyfcross.info;
    ssl_certificate /etc/letsencrypt/live/syllabi.baileyfcross.info/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/syllabi.baileyfcross.info/privkey.pem;
    client_max_body_size 210m;
    proxy_read_timeout 90s;
    add_header Strict-Transport-Security 'max-age=31536000; includeSubDomains' always;
    location / {
        proxy_pass http://127.0.0.1:8765;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
